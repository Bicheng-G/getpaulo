---
/**
 * The one main action. Links to the App Store once APP_STORE_ID is set in
 * src/config.ts; until then it says, truthfully, that Paulo is coming.
 */
import { APP_STORE_URL } from '../config';

interface Props {
  tone?: 'primary' | 'dark';
  size?: 'md' | 'sm';
  class?: string;
}

const { tone = 'primary', size = 'md', class: extra } = Astro.props;
const classes = ['btn', tone === 'dark' ? 'btn-dark' : 'btn-primary', size === 'sm' && 'btn-sm', extra];
---

{
  APP_STORE_URL ? (
    <a href={APP_STORE_URL} class:list={classes}>
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
        <path d="M16.37 12.6c-.02-2.2 1.8-3.26 1.88-3.31-1.03-1.5-2.62-1.7-3.18-1.73-1.35-.14-2.65.8-3.33.8-.69 0-1.75-.78-2.88-.76-1.48.02-2.85.86-3.61 2.19-1.54 2.67-.39 6.62 1.11 8.79.73 1.06 1.6 2.25 2.75 2.2 1.1-.04 1.52-.71 2.85-.71 1.33 0 1.71.71 2.87.69 1.19-.02 1.94-1.08 2.66-2.14.84-1.23 1.19-2.42 1.2-2.48-.03-.01-2.3-.88-2.32-3.5ZM14.2 6.13c.6-.74 1.01-1.75.9-2.77-.87.04-1.93.58-2.55 1.31-.56.65-1.05 1.69-.92 2.69.97.07 1.97-.49 2.57-1.23Z" />
      </svg>
      Download on the App Store
    </a>
  ) : (
    <a href="/support#coming-soon" class:list={classes}>
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
        <path d="M16.37 12.6c-.02-2.2 1.8-3.26 1.88-3.31-1.03-1.5-2.62-1.7-3.18-1.73-1.35-.14-2.65.8-3.33.8-.69 0-1.75-.78-2.88-.76-1.48.02-2.85.86-3.61 2.19-1.54 2.67-.39 6.62 1.11 8.79.73 1.06 1.6 2.25 2.75 2.2 1.1-.04 1.52-.71 2.85-.71 1.33 0 1.71.71 2.87.69 1.19-.02 1.94-1.08 2.66-2.14.84-1.23 1.19-2.42 1.2-2.48-.03-.01-2.3-.88-2.32-3.5ZM14.2 6.13c.6-.74 1.01-1.75.9-2.77-.87.04-1.93.58-2.55 1.31-.56.65-1.05 1.69-.92 2.69.97.07 1.97-.49 2.57-1.23Z" />
      </svg>
      {size === 'sm' ? 'Coming soon' : 'Coming soon to the App Store'}
    </a>
  )
}
