---
/**
 * Questions as native <details>: works without JavaScript, opens with the
 * keyboard, and animates its height where the browser supports
 * ::details-content (older browsers simply open instantly).
 */
interface Props {
  items: { q: string; a: string; id?: string }[];
}
const { items } = Astro.props;
---

<div class="faq">
  {
    items.map((item) => (
      <details class="faq-item" id={item.id}>
        <summary>
          <span class="faq-q">{item.q}</span>
          <span class="faq-icon" aria-hidden="true">
            <svg viewBox="0 0 16 16"><path d="M3 8h10M8 3v10" /></svg>
          </span>
        </summary>
        <div class="faq-a" set:html={item.a} />
      </details>
    ))
  }
</div>

<style>
  .faq {
    display: grid;
    gap: 10px;
  }

  .faq-item {
    border-radius: 22px;
    background: var(--color-card);
    box-shadow:
      0 1px 2px rgb(32 48 60 / 0.04),
      0 3px 10px rgb(32 48 60 / 0.04);
    interpolate-size: allow-keywords;
    transition: box-shadow 240ms ease;
  }

  .faq-item[open] {
    box-shadow:
      0 1px 2px rgb(32 48 60 / 0.05),
      0 10px 24px rgb(32 48 60 / 0.07);
  }

  .faq-item::details-content {
    block-size: 0;
    overflow: clip;
    transition:
      block-size 380ms var(--ease-out),
      content-visibility 380ms allow-discrete;
  }

  .faq-item[open]::details-content {
    block-size: auto;
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 64px;
    padding: 14px 22px;
    cursor: pointer;
    list-style: none;
    border-radius: 22px;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .faq-q {
    font-family: var(--font-serif);
    font-variation-settings: 'SOFT' 100, 'WONK' 0;
    font-size: 19px;
    font-weight: 580;
    line-height: 1.3;
  }

  .faq-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    border-radius: 99px;
    background: var(--color-paper);
    transition:
      rotate 420ms var(--spring),
      background-color 200ms ease;
  }

  .faq-icon svg {
    width: 14px;
    stroke: var(--color-ink);
    stroke-width: 2.2;
    stroke-linecap: round;
  }

  .faq-item[open] .faq-icon {
    rotate: 135deg;
    background: var(--color-glow);
  }

  @media (hover: hover) and (pointer: fine) {
    summary:hover .faq-icon {
      background: var(--color-glow);
    }
  }

  .faq-a {
    padding: 0 22px 22px;
    max-width: 44em;
    color: var(--color-ink-soft);
  }

  .faq-a :global(p + p) {
    margin-top: 10px;
  }

  .faq-a :global(a) {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-cta) 55%, transparent);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
</style>

<script>
  // Open the question a link points at (e.g. /support#coming-soon).
  const open = () => {
    const el = location.hash && document.getElementById(location.hash.slice(1));
    if (el instanceof HTMLDetailsElement) el.open = true;
  };
  open();
  window.addEventListener('hashchange', open);
</script>
