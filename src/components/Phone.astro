---
/**
 * An iPhone, drawn in CSS. The screen keeps the 1284×2778 proportion of the
 * real recordings; app screens in src/assets/screens start just under the
 * status bar, which this frame draws itself.
 *
 * Size it from outside with --w (the outer width).
 */
interface Props {
  label?: string;
  class?: string;
  style?: string;
  dark?: boolean;
}
const { label, class: extra, style, dark = false } = Astro.props;
---

<div class:list={['phone', extra]} style={style} role={label ? 'img' : undefined} aria-label={label}>
  <div class:list={['phone-screen', dark && 'is-dark']}>
    <div class="phone-status" aria-hidden="true">
      <span class="phone-time">9:41</span>
      <span class="phone-island"></span>
      <span class="phone-icons">
        <svg width="17" height="11" viewBox="0 0 17 11"><rect x="0" y="7" width="3" height="4" rx="0.8"></rect><rect x="4.5" y="5" width="3" height="6" rx="0.8"></rect><rect x="9" y="2.5" width="3" height="8.5" rx="0.8"></rect><rect x="13.5" y="0" width="3" height="11" rx="0.8"></rect></svg>
        <svg width="25" height="12" viewBox="0 0 25 12"><rect x="0.5" y="0.5" width="21" height="11" rx="3.2" fill="none" stroke="currentColor" opacity="0.4"></rect><rect x="2" y="2" width="18" height="8" rx="2"></rect><path d="M23 4v4c.8-.3 1.4-1.1 1.4-2s-.6-1.7-1.4-2z" opacity="0.4"></path></svg>
      </span>
    </div>
    <div class="phone-content">
      <slot />
    </div>
  </div>
</div>

<style>
  .phone {
    --w: 300px;
    position: relative;
    width: var(--w);
    aspect-ratio: 1284 / 2778;
    padding: calc(var(--w) * 0.032);
    border-radius: calc(var(--w) * 0.165);
    background: linear-gradient(145deg, #3b3d42, #17181b 40%, #0e0f11);
    box-shadow:
      inset 0 0 0 1.5px rgb(255 255 255 / 0.08),
      0 2px 4px rgb(32 48 60 / 0.08),
      0 18px 36px rgb(32 48 60 / 0.16),
      0 40px 80px rgb(32 48 60 / 0.14);
    flex-shrink: 0;
  }

  .phone-screen {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    isolation: isolate;
    border-radius: calc(var(--w) * 0.135);
    background-color: var(--color-paper);
    background-image: radial-gradient(
      circle at 1px 1px,
      color-mix(in srgb, #1f2a37 7%, transparent) 1px,
      transparent 0
    );
    background-size: calc(var(--w) * 0.06) calc(var(--w) * 0.06);
    color: var(--color-ink);
  }

  .phone-status {
    position: absolute;
    inset: 0 0 auto;
    z-index: 5;
    height: 5.4%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 9% 0 11%;
    font-size: calc(var(--w) * 0.048);
    font-weight: 700;
    pointer-events: none;
  }

  .phone-island {
    position: absolute;
    left: 50%;
    top: 22%;
    width: 31%;
    height: 62%;
    translate: -50% 0;
    border-radius: 999px;
    background: #0b0b0c;
  }

  .phone-icons {
    display: flex;
    gap: 5%;
    align-items: center;
    fill: currentColor;
  }

  .phone-icons svg {
    width: calc(var(--w) * 0.06);
    height: auto;
  }

  .phone-icons svg + svg {
    width: calc(var(--w) * 0.08);
  }

  .phone-content {
    position: absolute;
    inset: 5.4% 0 0;
  }

  .phone-content :global(> img),
  .phone-content :global(> video) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
</style>
