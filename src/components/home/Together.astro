---
/**
 * Ready is not done. When the stars are there the family picks a day; only when
 * the wish is really in the child's hands does Paulo call it come true.
 * Interaction: count the sleeps to Saturday, and the keepsake photo develops.
 */
import { Image } from 'astro:assets';
import Phone from '../Phone.astro';
import readyScreen from '../../assets/screens/ready.png';
import scene from '../../assets/clay/IntroFollowThrough.jpg';
---

<section class="together section-pad" id="together" aria-labelledby="together-title">
  <div class="wrap together-grid">
    <div class="together-art">
      <div class="together-phone">
        <Phone label="“My Car is ready!” with five stars, and a button: We have it, take a photo." style="--w: var(--tw)">
          <Image src={readyScreen} alt="" widths={[280, 560]} sizes="280px" />
        </Phone>
      </div>

      <figure class="polaroid" data-polaroid>
        <span class="polaroid-tape" aria-hidden="true"></span>
        <div class="polaroid-photo">
          <Image src={scene} alt="A clay family scene: a grown-up photographs a child holding the toy car they waited for." widths={[320, 560]} sizes="280px" />
        </div>
        <figcaption class="polaroid-note serif" data-note>We get it on Saturday</figcaption>
      </figure>
    </div>

    <div class="together-copy">
      <p class="eyebrow">Ready, then real</p>
      <h2 id="together-title" class="headline">Then you get it, <span class="accent">together.</span></h2>
      <p class="lede">
        Enough stars means the wish is <em>ready</em>, not done. You pick the day, they count the
        sleeps, and only when it’s really in their hands does Paulo call it a wish come true.
      </p>
      <p class="together-body">The moment is kept on My Trail, the family’s own path of things that really happened.</p>

      <div class="sleeps" data-sleeps>
        <p class="sleeps-label" data-sleeps-label aria-live="polite">3 sleeps until Saturday</p>
        <div class="moons">
          {[0, 1, 2].map((i) => (
            <span class="moon" data-moon style={`--i:${i}`} aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M15.5 3.2a8.6 8.6 0 1 0 5.3 13.6A7.2 7.2 0 0 1 15.5 3.2z"></path></svg>
            </span>
          ))}
        </div>
        <button type="button" class="btn btn-paper btn-sm" data-sleep>Go to sleep</button>
      </div>
    </div>
  </div>
</section>

<style>
  .together {
    overflow: clip;
  }

  .together-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: clamp(40px, 6vw, 96px);
  }

  .together-art {
    --tw: clamp(230px, 20vw, 270px);
    position: relative;
    display: flex;
    justify-content: center;
    padding: 20px 0 40px;
  }

  .together-phone {
    rotate: -4deg;
    translate: -18% 0;
  }

  .polaroid {
    position: absolute;
    right: -2%;
    bottom: 4%;
    width: 180px;
    padding: 12px 12px 18px;
    background: #fff;
    rotate: 6deg;
    box-shadow:
      0 2px 4px rgb(32 48 60 / 0.06),
      0 16px 36px rgb(32 48 60 / 0.16);
    transition: rotate 700ms var(--spring);
  }

  .polaroid.is-developed {
    rotate: 2deg;
  }

  .polaroid-tape {
    position: absolute;
    left: 50%;
    top: -12px;
    width: 86px;
    height: 24px;
    translate: -50% 0;
    rotate: -4deg;
    background: rgb(220 192 188 / 0.8);
    background-image: repeating-linear-gradient(90deg, rgb(255 255 255 / 0.25) 0 2px, transparent 2px 6px);
  }

  .polaroid-photo {
    aspect-ratio: 1;
    overflow: hidden;
    background: #2e2a24;
  }

  .polaroid-photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) brightness(0.55) blur(3px) contrast(0.8);
    transition: filter 2400ms var(--ease-out);
  }

  .polaroid.is-developed .polaroid-photo :global(img) {
    filter: none;
  }

  .polaroid-note {
    margin-top: 12px;
    text-align: center;
    font-size: 19px;
    font-style: italic;
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
  }

  .together-copy {
    order: -1;
  }

  .together-copy h2 {
    margin-top: 16px;
  }

  .together-copy .lede {
    margin-top: 22px;
    max-width: 26em;
  }

  .together-body {
    margin-top: 14px;
    max-width: 30em;
    color: var(--color-ink-soft);
  }

  .sleeps {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 20px;
    margin-top: 34px;
    padding: 18px 22px;
    border-radius: 24px;
    background: var(--color-card);
    box-shadow:
      0 1px 2px rgb(32 48 60 / 0.04),
      0 6px 16px rgb(32 48 60 / 0.06);
    width: fit-content;
    max-width: 100%;
  }

  .sleeps-label {
    flex-basis: 100%;
    font-weight: 800;
  }

  .moons {
    display: flex;
    gap: 10px;
  }

  .moon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 99px;
    background: #e4edf4;
  }

  .moon svg {
    width: 24px;
    fill: none;
    stroke: var(--color-dusty-blue);
    stroke-width: 1.8;
    transition: fill 300ms ease;
  }

  .moon.is-slept {
    background: #2f3a52;
    animation: moon-pop 700ms var(--spring-bouncy);
  }

  .moon.is-slept svg {
    fill: var(--color-glow);
    stroke: var(--color-glow);
  }

  @keyframes moon-pop {
    40% {
      transform: scale(1.18) rotate(-12deg);
    }
  }

  @media (min-width: 600px) {
    .together-phone {
      translate: -22% 0;
    }

    .polaroid {
      right: 2%;
      width: clamp(200px, 19vw, 260px);
    }
  }

  @media (min-width: 900px) {
    .together-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .together-copy {
      order: 0;
    }
  }
</style>

<script>
  const box = document.querySelector<HTMLElement>('[data-sleeps]');
  const polaroid = document.querySelector<HTMLElement>('[data-polaroid]');

  if (box && polaroid) {
    const moons = [...box.querySelectorAll<HTMLElement>('[data-moon]')];
    const label = box.querySelector<HTMLElement>('[data-sleeps-label]')!;
    const btn = box.querySelector<HTMLButtonElement>('[data-sleep]')!;
    const note = polaroid.querySelector<HTMLElement>('[data-note]')!;
    let slept = 0;

    btn.addEventListener('click', () => {
      if (slept >= moons.length) {
        slept = 0;
        moons.forEach((m) => m.classList.remove('is-slept'));
        polaroid.classList.remove('is-developed');
        note.textContent = 'We get it on Saturday';
        label.textContent = '3 sleeps until Saturday';
        btn.textContent = 'Go to sleep';
        return;
      }
      moons[slept].classList.add('is-slept');
      slept++;
      const left = moons.length - slept;
      if (left > 0) {
        label.textContent = `${left} ${left === 1 ? 'sleep' : 'sleeps'} until Saturday`;
      } else {
        label.textContent = 'It’s Saturday. We got it!';
        note.textContent = 'We got it! · Saturday';
        polaroid.classList.add('is-developed');
        btn.textContent = 'Wait again';
      }
    });
  }
</script>
