---
/** The one dark band: what Paulo promises a family, in plain facts. */
const facts = [
  {
    title: 'Free for children, forever',
    body: 'Wishes, stars, Choice Moments, tickets and timers, for any number of children. A child never sees a price.',
    icon: 'M12 3l2.6 5.6 6.1.8-4.5 4.2 1.2 6-5.4-3-5.4 3 1.2-6L3.3 9.4l6.1-.8z',
  },
  {
    title: 'No ads, no tracking',
    body: 'No analytics, no third-party SDKs, nothing that watches your family. Not in the app, not on this site.',
    icon: 'M3 12s3.5-6 9-6 9 6 9 6-3.5 6-9 6-9-6-9-6zM12 9.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM4 20L20 4',
  },
  {
    title: 'No account, no Paulo server',
    body: 'Photos, voice notes and stars live on your devices and in your own private iCloud. We never see them.',
    icon: 'M7 18h10a4 4 0 0 0 .6-7.95A6 6 0 0 0 6.2 9.1 4.5 4.5 0 0 0 7 18zM10 13.5l1.6 1.6 3.2-3.4',
  },
  {
    title: 'Grown-up pages stay grown-up',
    body: 'Settings and anything that spends stars sit behind a parent gate: a quick sum, or Face ID.',
    icon: 'M7 11V8a5 5 0 0 1 10 0v3M6 11h12v9H6zM12 14.5v2.5',
  },
];
---

<section class="trust" aria-labelledby="trust-title">
  <div class="wrap trust-inner">
    <div class="trust-head">
      <p class="eyebrow trust-eyebrow">Made to be trusted</p>
      <h2 id="trust-title" class="headline">
        Everything for your children is <span class="trust-accent">free, forever.</span>
      </h2>
      <p class="trust-lede">
        A promise a family can’t trust teaches the opposite of what it says. So Paulo keeps its own
        promises too: stars never quietly vanish, and every correction leaves a visible line.
      </p>
    </div>

    <ul class="trust-grid">
      {
        facts.map((f) => (
          <li class="trust-card">
            <span class="trust-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d={f.icon}></path></svg>
            </span>
            <h3 class="trust-title">{f.title}</h3>
            <p>{f.body}</p>
          </li>
        ))
      }
    </ul>

    <div class="trust-links">
      <a href="/privacy" class="btn btn-dark">Read the privacy policy</a>
      <a href="/pricing" class="trust-link">What Paulo Family adds for grown&#8209;ups&nbsp;→</a>
    </div>
  </div>
</section>

<style>
  .trust {
    position: relative;
    margin: clamp(24px, 4vw, 48px) clamp(8px, 2vw, 24px);
    padding: clamp(56px, 9vw, 128px) 0;
    border-radius: clamp(28px, 4vw, 48px);
    background: var(--color-wins-deep);
    color: var(--color-cta-label);
    overflow: hidden;
  }

  .trust::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 1px 1px, rgb(255 244 230 / 0.06) 1.5px, transparent 0);
    background-size: 28px 28px;
    pointer-events: none;
  }

  .trust-inner {
    position: relative;
  }

  .trust-eyebrow {
    color: rgb(255 244 230 / 0.6);
  }

  .trust-head h2 {
    margin-top: 16px;
    max-width: 14em;
  }

  .trust-accent {
    color: var(--color-star);
  }

  .trust-lede {
    margin-top: 22px;
    max-width: 36em;
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    color: rgb(255 244 230 / 0.72);
  }

  .trust-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
    margin-top: clamp(32px, 5vw, 64px);
  }

  /* Phones: compact rows, icon beside the text. Tall cards from 600px. */
  .trust-card {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    column-gap: 16px;
    align-items: start;
    padding: 20px 20px 22px;
    border-radius: 26px;
    background: rgb(255 244 230 / 0.06);
    box-shadow: inset 0 0 0 1px rgb(255 244 230 / 0.08);
    transition: background-color 300ms ease, translate 300ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .trust-card:hover {
      background: rgb(255 244 230 / 0.09);
      translate: 0 -2px;
    }

    .trust-card:hover .trust-icon {
      rotate: -8deg;
      scale: 1.06;
    }
  }

  .trust-icon {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 14px;
    background: rgb(240 184 76 / 0.16);
    transition: rotate 500ms var(--spring-bouncy), scale 500ms var(--spring-bouncy);
  }

  .trust-icon svg {
    width: 24px;
    fill: none;
    stroke: var(--color-star);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .trust-title {
    margin-top: 0;
    font-size: 19px;
    line-height: 1.2;
  }

  .trust-card p {
    margin-top: 6px;
    font-size: 15px;
    color: rgb(255 244 230 / 0.68);
  }

  .trust-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    margin-top: clamp(36px, 4vw, 52px);
  }

  .trust-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-wrap: balance;
    font-weight: 800;
    color: var(--color-cta-label);
    text-decoration: underline;
    text-decoration-color: rgb(255 244 230 / 0.3);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
    transition: text-decoration-color 200ms ease;
  }

  .trust-link:hover {
    text-decoration-color: var(--color-star);
  }

  @media (min-width: 600px) {
    .trust-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .trust-card {
      display: block;
      padding: 26px 24px 28px;
    }

    .trust-icon {
      width: 48px;
      height: 48px;
      border-radius: 16px;
    }

    .trust-title {
      margin-top: 18px;
      font-size: 20px;
    }

    .trust-card p {
      margin-top: 8px;
      font-size: 15.5px;
    }
  }

  @media (min-width: 1200px) {
    .trust-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
