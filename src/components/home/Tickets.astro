---
/**
 * My Week, playable: tear a ticket off a book. Tickets are given, not earned;
 * tearing one off and putting the book away are equally easy (no preference).
 * A timed ticket starts its little clock, sped up for the website.
 */
import { Image } from 'astro:assets';
import clock from '../../assets/clay/MyWeekAlarmClock.png';

const books = [
  { id: 'tv', name: 'TV', unit: '10 minutes', count: 2, tone: 'lilac', timed: true },
  { id: 'jelly', name: 'Jelly', unit: 'one jelly', count: 1, tone: 'sage', timed: false },
];
---

<section class="week section-pad" id="my-week" aria-labelledby="week-title">
  <div class="wrap week-grid">
    <div class="week-copy">
      <p class="eyebrow">My Week</p>
      <h2 id="week-title" class="headline">Their week, <span class="accent">their&nbsp;call.</span></h2>
      <p class="lede">
        You agree how many: two episodes of TV, one jelly. They decide when, by tearing off a
        ticket.
      </p>
      <ul class="week-points">
        <li><b>Given, not earned.</b> A ticket is never a reward, and never taken away for a bad day.</li>
        <li><b>The book is the rule.</b> Its thickness is what’s left. You don’t have to be the one who says no.</li>
        <li><b>A timer says “time’s up”.</b> Not a tired grown-up. No “five more minutes”.</li>
      </ul>
    </div>

    <div class="week-stage" data-week>
      <p class="week-try">Try it: tear one off.</p>
      <div class="books">
        {
          books.map((b) => (
            <div class={`book tone-${b.tone}`} data-book={b.id} data-count={b.count} data-timed={b.timed ? '1' : '0'} data-name={b.name}>
              <div class="book-stack" data-stack>
                {Array.from({ length: b.count }, (_, i) => (
                  <button type="button" class="ticket" data-ticket style={`--k:${b.count - 1 - i}`} aria-label={`Tear off a ${b.name} ticket`}>
                    <span class="ticket-side" aria-hidden="true">This week</span>
                    <span class="ticket-main" aria-hidden="true">
                      <span class="ticket-name serif">{b.name}</span>
                      <span class="ticket-unit">{b.unit}</span>
                    </span>
                    <span class="ticket-tape" aria-hidden="true" />
                  </button>
                ))}
                <div class="ticket-empty" aria-hidden="true">
                  <span class="ticket-stamp">All done</span>
                </div>
              </div>
              <p class="book-left" data-left aria-live="polite">{b.count} left this week</p>
            </div>
          ))
        }
      </div>

      <div class="timer" data-timer hidden>
        <Image src={clock} alt="" width={120} class="timer-clock" />
        <div>
          <p class="timer-title serif" data-timer-title>TV</p>
          <p class="timer-line" data-timer-line aria-live="polite">About 10 minutes left</p>
        </div>
        <svg class="timer-ring" viewBox="0 0 40 40" aria-hidden="true">
          <circle cx="20" cy="20" r="16" fill="none" stroke="rgb(32 48 60 / 0.1)" stroke-width="5"></circle>
          <circle class="timer-arc" data-arc cx="20" cy="20" r="16" fill="none" stroke="var(--color-cta)" stroke-width="5" stroke-linecap="round" pathLength="100" stroke-dasharray="100" stroke-dashoffset="0" transform="rotate(-90 20 20)"></circle>
        </svg>
      </div>

      <button type="button" class="btn btn-paper btn-sm week-monday" data-monday hidden>
        It’s Monday: new tickets
      </button>
    </div>
  </div>
</section>

<style is:global>
  .week-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: clamp(40px, 6vw, 96px);
  }

  .week-copy h2 {
    margin-top: 16px;
  }

  .week-copy .lede {
    margin-top: 22px;
    max-width: 26em;
  }

  .week-points {
    display: grid;
    gap: 14px;
    margin-top: 30px;
    max-width: 32em;
    color: var(--color-ink-soft);
  }

  .week-points li {
    padding-left: 22px;
    position: relative;
  }

  .week-points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 10px;
    height: 10px;
    border-radius: 3px;
    rotate: 45deg;
    background: var(--color-clay);
  }

  .week-points b {
    color: var(--color-ink);
  }

  .week-stage {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    padding: clamp(28px, 4vw, 48px) clamp(16px, 3vw, 40px);
    border-radius: var(--radius-sheet);
    background: var(--color-card-warm);
    box-shadow:
      inset 0 0 0 1px rgb(32 48 60 / 0.05),
      0 10px 30px rgb(32 48 60 / 0.06);
  }

  .week-try {
    font-family: var(--font-serif);
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
    font-style: italic;
    font-size: 18px;
    color: var(--color-ink-soft);
  }

  .books {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 28px;
  }

  .book {
    --paper: #e9e4f2;
    --ink-tone: #6a5f8e;
    --tape: rgb(195 188 216 / 0.75);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .book.tone-sage {
    --paper: #e8ebdc;
    --ink-tone: #6b7148;
    --tape: rgb(183 188 147 / 0.75);
  }

  .book-stack {
    position: relative;
    width: 168px;
    height: 96px;
  }

  .ticket,
  .ticket-empty {
    position: absolute;
    inset: 0;
    display: flex;
    border-radius: 12px;
  }

  .ticket {
    z-index: calc(10 - var(--k));
    padding: 0;
    border: 0;
    background: var(--paper);
    color: var(--ink-tone);
    text-align: left;
    translate: calc(var(--k) * 4px) calc(var(--k) * 5px);
    rotate: calc(var(--k) * 1.5deg);
    box-shadow:
      0 1px 0 rgb(0 0 0 / 0.04),
      0 4px 10px rgb(32 48 60 / 0.1);
    touch-action: none;
    cursor: grab;
    transition:
      translate 500ms var(--spring),
      rotate 500ms var(--spring);
    /* paper grain */
    background-image:
      radial-gradient(circle at 20% 30%, rgb(255 255 255 / 0.35), transparent 40%),
      radial-gradient(circle at 80% 70%, rgb(0 0 0 / 0.03), transparent 50%);
  }

  .ticket:active {
    cursor: grabbing;
  }

  .ticket-side {
    display: grid;
    place-items: center;
    width: 34px;
    flex-shrink: 0;
    border-right: 2px dashed color-mix(in srgb, var(--ink-tone) 35%, transparent);
    writing-mode: vertical-rl;
    rotate: 180deg;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .ticket-main {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 18px;
  }

  .ticket-name {
    font-size: 24px;
    line-height: 1;
    font-weight: 620;
    color: var(--color-ink);
  }

  .ticket-unit {
    margin-top: 6px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .ticket-tape {
    position: absolute;
    left: 50%;
    top: -9px;
    width: 64px;
    height: 20px;
    translate: -30% 0;
    rotate: -3deg;
    background: var(--tape);
    background-image: repeating-linear-gradient(90deg, rgb(255 255 255 / 0.25) 0 2px, transparent 2px 6px);
  }

  .ticket-empty {
    z-index: 0;
    align-items: center;
    justify-content: center;
    border: 2px dashed color-mix(in srgb, var(--ink-tone) 30%, transparent);
    background: color-mix(in srgb, var(--paper) 45%, transparent);
  }

  .ticket-stamp {
    padding: 4px 12px;
    border: 2.5px solid var(--ink-tone);
    border-radius: 8px;
    rotate: -8deg;
    font-size: 14px;
    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-tone);
    opacity: 0.25;
    transition: opacity 300ms ease, scale 600ms var(--spring-bouncy);
    scale: 1.3;
  }

  .book.is-empty .ticket-stamp {
    opacity: 0.85;
    scale: 1;
  }

  .book-left {
    font-size: 14px;
    font-weight: 700;
    color: var(--color-ink-soft);
  }

  .timer {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 18px 12px 12px;
    border-radius: 22px;
    background: #efe2d6;
    box-shadow: 0 4px 12px rgb(32 48 60 / 0.08);
    animation: timer-in 700ms var(--spring-bouncy) both;
  }

  .timer[hidden] {
    display: none;
  }

  @keyframes timer-in {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.9);
    }
  }

  .timer-clock {
    width: 56px;
    height: auto;
  }

  .timer.is-ringing .timer-clock {
    animation: ring 140ms ease-in-out 8 alternate;
  }

  @keyframes ring {
    from {
      rotate: -8deg;
    }
    to {
      rotate: 8deg;
    }
  }

  .timer-title {
    font-size: 20px;
    font-weight: 600;
  }

  .timer-line {
    font-size: 14px;
    font-weight: 700;
    color: var(--color-ink-soft);
  }

  .timer-ring {
    width: 38px;
    margin-left: 8px;
  }

  .week-monday[hidden] {
    display: none;
  }

  @media (min-width: 600px) {
    .book-stack {
      width: 188px;
      height: 104px;
    }

    .ticket-name {
      font-size: 30px;
    }
  }

  @media (min-width: 900px) {
    .week-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
</style>

<script>
  import { reduced } from '../../scripts/motion';

  const stage = document.querySelector<HTMLElement>('[data-week]');

  if (stage) {
    const timer = stage.querySelector<HTMLElement>('[data-timer]')!;
    const timerTitle = stage.querySelector<HTMLElement>('[data-timer-title]')!;
    const timerLine = stage.querySelector<HTMLElement>('[data-timer-line]')!;
    const arc = stage.querySelector<SVGCircleElement>('[data-arc]')!;
    const monday = stage.querySelector<HTMLButtonElement>('[data-monday]')!;
    const books = [...stage.querySelectorAll<HTMLElement>('[data-book]')];
    const templates = new Map(books.map((b) => [b, b.querySelector('[data-ticket]')!.cloneNode(true) as HTMLElement]));
    let timerAnim: Animation | null = null;
    let timerDone = 0;

    const leftText = (n: number) => (n === 0 ? 'All done · more on Monday' : `${n} left this week`);

    function refresh(book: HTMLElement) {
      const n = book.querySelectorAll('[data-ticket]').length;
      book.querySelector('[data-left]')!.textContent = leftText(n);
      book.classList.toggle('is-empty', n === 0);
      book.querySelectorAll<HTMLElement>('[data-ticket]').forEach((t, i, all) => t.style.setProperty('--k', String(all.length - 1 - i)));
      monday.hidden = !books.some((b) => b.querySelectorAll('[data-ticket]').length === 0);
    }

    function startTimer(name: string) {
      clearTimeout(timerDone);
      timerAnim?.cancel();
      timer.hidden = false;
      timer.classList.remove('is-ringing');
      timerTitle.textContent = name;
      timerLine.textContent = 'About 10 minutes left (sped up here)';
      const ms = reduced() ? 1500 : 6000;
      timerAnim = arc.animate([{ strokeDashoffset: 0 }, { strokeDashoffset: 100 }], { duration: ms, easing: 'linear', fill: 'forwards' });
      timerDone = window.setTimeout(() => {
        timerLine.textContent = `My ${name} turn is finished.`;
        timer.classList.add('is-ringing');
      }, ms);
    }

    async function tear(ticket: HTMLElement, vx = 0, vy = 1) {
      const book = ticket.closest<HTMLElement>('[data-book]')!;
      if (ticket.dataset.torn) return;
      ticket.dataset.torn = '1';
      const from = getComputedStyle(ticket).transform;
      ticket.style.pointerEvents = 'none';
      const dir = vx >= 0 ? 1 : -1;
      if (!reduced()) {
        await ticket.animate(
          [
            { transform: from === 'none' ? 'translate(0,0)' : from, opacity: 1 },
            { transform: `translate(${dir * 30 + vx * 0.2}px, ${-24}px) rotate(${dir * 10}deg)`, opacity: 1, offset: 0.25 },
            { transform: `translate(${dir * 140 + vx * 0.4}px, ${260 + vy * 0.2}px) rotate(${dir * 48}deg)`, opacity: 0 },
          ],
          { duration: 700, easing: 'cubic-bezier(0.3, 0, 0.7, 1)', fill: 'forwards' },
        ).finished.catch(() => undefined);
      }
      ticket.remove();
      refresh(book);
      if (book.dataset.timed === '1') startTimer(book.dataset.name!);
    }

    function bindTicket(ticket: HTMLElement) {
      let id: number | null = null;
      let sx = 0;
      let sy = 0;
      let dx = 0;
      let dy = 0;
      let t0 = 0;

      ticket.addEventListener('pointerdown', (e) => {
        // Only the top ticket of a book can be torn.
        const book = ticket.closest('[data-book]')!;
        const all = book.querySelectorAll('[data-ticket]');
        if (all[all.length - 1] !== ticket || id !== null) return;
        id = e.pointerId;
        sx = e.clientX;
        sy = e.clientY;
        dx = dy = 0;
        t0 = performance.now();
        ticket.setPointerCapture(e.pointerId);
        ticket.style.transition = 'none';
      });

      ticket.addEventListener('pointermove', (e) => {
        if (e.pointerId !== id) return;
        dx = e.clientX - sx;
        dy = e.clientY - sy;
        if (reduced()) return;
        // The perforation holds: the further you pull, the harder it resists.
        const d = Math.hypot(dx, dy);
        const k = d === 0 ? 0 : (Math.min(d, 260) * (1 - Math.min(d, 260) / 520)) / d;
        ticket.style.translate = `${dx * k}px ${dy * k}px`;
        ticket.style.rotate = `${dx * k * 0.08}deg`;
      });

      const end = (e: PointerEvent) => {
        if (e.pointerId !== id) return;
        id = null;
        const dist = Math.hypot(dx, dy);
        const v = dist / Math.max(1, performance.now() - t0);
        ticket.style.transition = '';
        if (dist < 6) {
          ticket.style.translate = '';
          ticket.style.rotate = '';
          tear(ticket, 1, 1);
          return;
        }
        if (dist > 70 || v > 0.6) {
          tear(ticket, dx, dy);
        } else {
          ticket.style.translate = '';
          ticket.style.rotate = '';
        }
      };
      ticket.addEventListener('pointerup', end);
      ticket.addEventListener('pointercancel', end);
      ticket.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          tear(ticket, 1, 1);
        }
      });
    }

    books.forEach((b) => {
      b.querySelectorAll<HTMLElement>('[data-ticket]').forEach(bindTicket);
      refresh(b);
    });

    monday.addEventListener('click', () => {
      books.forEach((b) => {
        const stack = b.querySelector('[data-stack]')!;
        const want = Number(b.dataset.count);
        const have = b.querySelectorAll('[data-ticket]').length;
        for (let i = have; i < want; i++) {
          const t = templates.get(b)!.cloneNode(true) as HTMLElement;
          stack.insertBefore(t, stack.querySelector('[data-ticket]'));
          bindTicket(t);
          if (!reduced()) {
            t.animate([{ opacity: 0, transform: 'translateY(-30px) rotate(-6deg)' }, { opacity: 1, transform: 'none' }], {
              duration: 700,
              delay: i * 90,
              easing: 'cubic-bezier(0.23, 1, 0.32, 1)',
              fill: 'backwards',
            });
          }
        }
        refresh(b);
      });
      timer.hidden = true;
      timerAnim?.cancel();
      clearTimeout(timerDone);
      stage.querySelector<HTMLElement>('[data-ticket]')?.focus({ preventScroll: true });
    });
  }
</script>
