---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import rideOn from '../assets/clay/TemptationRideOn.png';
import sceneMoment from '../assets/clay/IntroMoment.jpg';
import sceneEither from '../assets/clay/IntroEitherAnswer.jpg';
import stone from '../assets/ui/stone.png';

const research = [
  {
    level: 'High',
    finding: 'Waiting depends on the situation. It isn’t a fixed trait, and turning a choice into a moral test is neither scientific nor kind.',
    paulo: 'The two options are perfectly symmetrical before the choice. The child is never scored.',
  },
  {
    level: 'Medium–high',
    finding: 'Children wait longer when the adults around them have just proved reliable (Kidd et al., 2013).',
    paulo: 'The stars can’t be quietly changed. A failed save never shows as a success.',
  },
  {
    level: 'High',
    finding: 'Expected, tangible rewards can weaken a child’s own motivation (Deci et al., 1999).',
    paulo: 'Stars are never for chores, good behaviour or kindness.',
  },
  {
    level: 'Medium–high',
    finding: 'Feedback about the process helps persistence; praising cleverness can backfire (Mueller & Dweck; Brummelman).',
    paulo: 'Paulo describes what happened (“I chose this today”), never “you’re so good at waiting”.',
  },
  {
    level: 'Medium',
    finding: 'Offering choices within limits is the autonomy support most consistently linked to young children’s executive function.',
    paulo: 'Grown-ups set the deal; inside it, the child decides.',
  },
  {
    level: 'Medium',
    finding: 'Remembering their own past kind acts makes 6–8-year-olds more willing to share later; remembering other people’s doesn’t.',
    paulo: 'My Trail keeps things your child really did.',
  },
];

const nots = [
  { not: 'A reward chart', why: 'Points turn “I want it” into “I want the points”.', is: 'A family promise you can trust' },
  { not: 'Chores for pocket money', why: 'Helping at home is belonging, not a trade.', is: 'Money, chores and growing up kept apart' },
  { not: 'A score for your child', why: 'Self-control depends on the moment; an app can’t judge it.', is: 'A record of what happened, never of who they are' },
  { not: 'A sibling leaderboard', why: 'Comparison makes a child a number to be beaten.', is: 'Each child sees only their own path' },
  { not: 'Streaks and check-ins', why: '“Don’t break the streak” is fear of losing, aimed at an app.', is: 'No daily tasks, no “you haven’t logged in”' },
  { not: 'A screen game', why: 'At 4 to 8, growing up happens off the screen.', is: 'A few seconds, then back to the world' },
  { not: 'A parental control tool', why: 'There is no button that says no for you.', is: 'Help for grown-ups to stay consistent' },
  { not: 'An AI that judges', why: 'No algorithm gets to say who a child is.', is: 'AI only suggests a name for a wish sticker' },
];
---

<BaseLayout
  title="Our story"
  description="Paulo started with a toy car, a ride-on and a four-year-old who made his own choice. Why the app works the way it does, what research says and doesn't, and what Paulo refuses to be."
>
  <PageHero eyebrow="Our story" id="story-title">
    <Fragment slot="title">It started with a toy car <span class="accent">and a ride-on.</span></Fragment>
    <Fragment slot="lede">
      <p>
        Not with a market, a framework or a pitch. With one small, real experiment at home, and a
        four-year-old who got to decide.
      </p>
    </Fragment>
    <div slot="art" class="story-art">
      <div class="story-photo">
        <Image src={sceneMoment} alt="Clay scene: a child stands by a ride-on outside a toy shop, a grown-up beside him." widths={[400, 720]} sizes="(max-width: 900px) 90vw, 440px" loading="eager" />
      </div>
      <div class="story-ride" data-poke tabindex="0" role="img" aria-label="A clay ride-on rocket">
        <Image src={rideOn} alt="" width={240} loading="eager" />
      </div>
    </div>
  </PageHero>

  <!-- The experiment -->
  <section class="section-pad tale" aria-labelledby="tale-title">
    <div class="wrap tale-grid">
      <div class="tale-copy">
        <p class="eyebrow">July 2026</p>
        <h2 id="tale-title" class="headline">Skip four rides, <span class="accent">get the car.</span></h2>
        <div class="tale-body">
          <p>
            A ride on the ride-on cost 2. A little toy car cost 8. The ride is over in two minutes; the
            car can be played with for ages, and kept. So the deal was simple: skip four rides, and the
            car is yours.
          </p>
          <p>
            He listened. He saved a few times, and in the end he really did buy the car. The most
            important part, looking back, was that the choice was completely his. Now and then he
            wanted the ride, and a grown-up asked “Are you sure?”, but nobody chose for him.
          </p>
          <p class="tale-name">Paulo is named after that boy.</p>
        </div>
      </div>

      <div class="tale-sum" aria-label="Four rides skipped, one car">
        <div class="tale-stones">
          {[0, 1, 2, 3].map((i) => (
            <span class="tale-stone" style={`--i:${i}`}>
              <Image src={stone} alt="" width={100} />
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.6l2.6 5.6 6.1.8-4.5 4.2 1.2 6-5.4-3-5.4 3 1.2-6L3.3 9l6.1-.8z"></path></svg>
            </span>
          ))}
        </div>
        <p class="tale-eq serif">4 × 2 = <span class="accent">one car</span></p>
      </div>
    </div>
  </section>

  <!-- Two problems -->
  <section class="section-pad problems" aria-labelledby="problems-title">
    <div class="wrap">
      <h2 id="problems-title" class="headline">Two things went wrong <span class="accent">along the way.</span></h2>
      <div class="problems-grid">
        <article class="card problem">
          <p class="problem-n serif">1</p>
          <h3 class="title">Grown-ups forget the count</h3>
          <p>How many times has he saved? Nobody could quite remember. A promise nobody can remember soon stops being believed.</p>
        </article>
        <article class="card problem">
          <p class="problem-n serif">2</p>
          <h3 class="title">Children can’t see their effort</h3>
          <p>A wish, a running total, the remarkable fact of “I held back”: to a four-year-old, all of it is invisible. “2” on a screen weighs nothing.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Mirror or coach -->
  <section class="section-pad mc" aria-labelledby="mc-title" data-mc>
    <div class="wrap">
      <p class="eyebrow">The first big question</p>
      <h2 id="mc-title" class="headline">A mirror, <span class="accent">or a coach?</span></h2>
      <p class="lede mc-lede">
        Should Paulo only show the choice, trusting the child completely? Or should it try to make
        saving more attractive, because parents want an app that works? Pick who is looking.
      </p>

      <div class="mc-switch" role="radiogroup" aria-label="Who is looking at Paulo">
        <button type="button" role="radio" aria-checked="true" data-who="child">The child</button>
        <button type="button" role="radio" aria-checked="false" data-who="grownup">The grown-up</button>
        <span class="mc-thumb" aria-hidden="true"></span>
      </div>

      <div class="mc-grid" data-mc-grid data-who="child">
        <article class="mc-card mc-mirror">
          <p class="mc-tag">For the child</p>
          <h3 class="title">A mirror</h3>
          <p>Paulo shows both choices and what each one does. It recommends nothing, nudges nothing, and records the choice without judging it.</p>
        </article>
        <article class="mc-card mc-coach">
          <p class="mc-tag">For the grown-up</p>
          <h3 class="title">A coach</h3>
          <p>Paulo helps you be consistent: it remembers the count, keeps the agreement visible, and is there in the moment you’d otherwise have to improvise.</p>
        </article>
      </div>

      <p class="mc-answer serif">We guide attention. <span class="accent">We never steer the decision.</span></p>
    </div>
  </section>

  <!-- Research -->
  <section class="section-pad res" aria-labelledby="res-title">
    <div class="wrap">
      <div class="res-head">
        <p class="eyebrow">What the research says, and doesn’t</p>
        <h2 id="res-title" class="headline">Not willpower training. <span class="accent">A better moment to choose in.</span></h2>
        <p class="lede">
          The famous marshmallow test suggested children who waited did better later. A large
          replication (Watts et al., 2018) found that link shrinks a lot once family background is
          taken into account. Waiting turns out to be a sensible response to the situation a child is in.
        </p>
      </div>

      <ul class="res-grid">
        {
          research.map((r) => (
            <li class="res-card">
              <p class="res-level">Evidence: {r.level}</p>
              <p class="res-finding">{r.finding}</p>
              <p class="res-paulo"><b>So in Paulo:</b> {r.paulo}</p>
            </li>
          ))
        }
      </ul>

      <aside class="redline">
        <p class="redline-h serif">The honest part</p>
        <p>
          The research supports these mechanisms. It doesn’t prove that Paulo works: Paulo hasn’t been
          tested with families yet. Until it has, every claim we make is a hypothesis, and we’ll say so.
        </p>
      </aside>
    </div>
  </section>

  <!-- What Paulo is not -->
  <section class="section-pad notp" aria-labelledby="notp-title">
    <div class="wrap notp-grid">
      <div class="notp-head">
        <p class="eyebrow">What Paulo isn’t</p>
        <h2 id="notp-title" class="headline">Defined by what it <span class="accent">won’t do.</span></h2>
        <div class="notp-scene">
          <Image src={sceneEither} alt="Clay scene in two halves: a child happily riding a ride-on, and the same child at home beside a path of stones with stars." widths={[360, 640]} sizes="(max-width: 900px) 90vw, 380px" />
        </div>
      </div>
      <ul class="notp-list">
        {
          nots.map((n) => (
            <li class="notp-row">
              <p class="notp-not">{n.not}</p>
              <p class="notp-why">{n.why}</p>
              <p class="notp-is"><span aria-hidden="true">→</span> {n.is}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- How we'll know -->
  <section class="section-pad know" aria-labelledby="know-title">
    <div class="wrap">
      <h2 id="know-title" class="headline">How we’ll know it’s working, <span class="accent">and when we’d stop.</span></h2>
      <div class="know-grid">
        <div class="know-col">
          <h3 class="title">We hope to see</h3>
          <ul>
            <li>Children starting the choice themselves, more and more</li>
            <li>Grown-ups not overruling the child’s choice</li>
            <li>A whole Choice Moment done in twenty seconds</li>
            <li>Families trusting that stars and agreements are safe</li>
            <li>Children weighing up choices without the app</li>
          </ul>
        </div>
        <div class="know-col know-stop">
          <h3 class="title">We’d stop or change if</h3>
          <ul>
            <li>The screens made a child sad</li>
            <li>Grown-ups started pushing children to save</li>
            <li>Everyday chores turned into bargaining</li>
            <li>Promises were quietly broken or hidden</li>
            <li>A child played with Paulo alone, for no real reason</li>
          </ul>
        </div>
      </div>
      <p class="know-note">
        Paulo has no analytics, on purpose. So we learn from families who tell us:
        <a class="link" href="/support">write to us</a>.
      </p>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .story-art {
    position: relative;
    width: min(100%, 440px);
  }

  .story-photo {
    border-radius: var(--radius-keepsake);
    overflow: hidden;
    rotate: 2deg;
    box-shadow: 0 20px 50px rgb(32 48 60 / 0.16);
  }

  .story-photo :global(img),
  .story-ride :global(img),
  .notp-scene :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .story-ride {
    position: absolute;
    left: -6%;
    bottom: -10%;
    width: 42%;
    filter: drop-shadow(0 14px 18px rgb(32 48 60 / 0.2));
  }

  /* The experiment */
  .tale-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }

  .tale-copy h2 {
    margin-top: 16px;
  }

  .tale-body {
    display: grid;
    gap: 14px;
    margin-top: 24px;
    max-width: 34em;
    font-size: 18px;
    color: var(--color-ink-soft);
  }

  .tale-name {
    font-family: var(--font-serif);
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
    font-style: italic;
    font-size: 24px;
    color: var(--color-ink);
  }

  .tale-sum {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    padding: clamp(28px, 4vw, 48px);
    border-radius: var(--radius-sheet);
    background: var(--color-card);
    box-shadow: 0 10px 30px rgb(32 48 60 / 0.06);
  }

  .tale-stones {
    display: flex;
    gap: 6%;
    width: 100%;
    justify-content: center;
  }

  .tale-stone {
    position: relative;
    width: 22%;
    rotate: calc((var(--i) - 1.5) * 6deg);
    transition: translate 500ms var(--spring-bouncy);
    transition-delay: calc(var(--i) * 50ms);
  }

  .tale-sum:hover .tale-stone {
    translate: 0 -8px;
  }

  .tale-stone :global(img) {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 3px 3px rgb(32 48 60 / 0.12));
  }

  .tale-stone svg {
    position: absolute;
    left: 50%;
    top: 44%;
    width: 60%;
    translate: -50% -50%;
    fill: var(--color-star);
    stroke: var(--color-star-deep);
    stroke-width: 1.2;
  }

  .tale-eq {
    font-size: clamp(28px, 3vw, 38px);
    font-weight: 560;
  }

  /* Problems */
  .problems h2 {
    max-width: 14em;
  }

  .problems-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    margin-top: clamp(32px, 4vw, 52px);
  }

  .problem {
    padding: clamp(24px, 3.4vw, 40px);
  }

  .problem-n {
    font-size: 64px;
    line-height: 0.9;
    font-weight: 600;
    color: var(--color-clay);
  }

  .problem h3 {
    margin-top: 12px;
  }

  .problem p:last-child {
    margin-top: 10px;
    color: var(--color-ink-soft);
  }

  /* Mirror / coach */
  .mc h2 {
    margin-top: 16px;
  }

  .mc-lede {
    margin-top: 20px;
    max-width: 36em;
  }

  .mc-switch {
    position: relative;
    display: inline-grid;
    grid-template-columns: 1fr 1fr;
    margin-top: 32px;
    padding: 6px;
    border-radius: 999px;
    background: var(--color-card);
    box-shadow: 0 1px 2px rgb(32 48 60 / 0.05), 0 6px 16px rgb(32 48 60 / 0.06);
  }

  .mc-switch button {
    position: relative;
    z-index: 1;
    min-height: 48px;
    padding: 0 16px;
    border: 0;
    border-radius: 999px;
    background: none;
    font-weight: 800;
    color: var(--color-ink-soft);
    transition: color 260ms ease;
  }

  .mc-switch button[aria-checked='true'] {
    color: var(--color-cta-label);
  }

  .mc-thumb {
    position: absolute;
    top: 6px;
    bottom: 6px;
    left: 6px;
    width: calc(50% - 6px);
    border-radius: 999px;
    background: var(--color-ink);
    transition: translate 520ms var(--spring);
  }

  .mc-switch:has([data-who='grownup'][aria-checked='true']) .mc-thumb {
    translate: 100% 0;
  }

  .mc-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    margin-top: 28px;
  }

  .mc-card {
    padding: clamp(24px, 3.4vw, 40px);
    border-radius: var(--radius-card);
    background: var(--color-card);
    box-shadow: 0 1px 2px rgb(32 48 60 / 0.04), 0 10px 26px rgb(32 48 60 / 0.06);
    transition:
      opacity 360ms ease,
      scale 600ms var(--spring),
      filter 360ms ease;
  }

  .mc-card p:last-child {
    margin-top: 10px;
    color: var(--color-ink-soft);
  }

  .mc-tag {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-cta);
  }

  .mc-card h3 {
    margin-top: 8px;
  }

  .mc-grid[data-who='child'] .mc-coach,
  .mc-grid[data-who='grownup'] .mc-mirror {
    opacity: 0.45;
    scale: 0.97;
    filter: saturate(0.4);
  }

  .mc-answer {
    margin-top: clamp(32px, 4vw, 48px);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1.15;
    font-weight: 560;
    max-width: 20em;
  }

  /* Research */
  .res-head h2 {
    margin-top: 16px;
    max-width: 16em;
  }

  .res-head .lede {
    margin-top: 20px;
    max-width: 40em;
  }

  .res-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    margin-top: clamp(32px, 4vw, 52px);
  }

  .res-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px;
    border-radius: 26px;
    background: var(--color-card);
    box-shadow: 0 1px 2px rgb(32 48 60 / 0.04), 0 4px 14px rgb(32 48 60 / 0.05);
  }

  .res-level {
    width: fit-content;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--color-paper);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: var(--color-ink-soft);
  }

  .res-finding {
    font-weight: 600;
  }

  .res-paulo {
    margin-top: auto;
    padding-top: 12px;
    border-top: 1.5px dashed rgb(32 48 60 / 0.12);
    font-size: 15.5px;
    color: var(--color-ink-soft);
  }

  .res-paulo b {
    color: var(--color-cta);
  }

  .redline {
    margin-top: 24px;
    padding: clamp(22px, 3vw, 32px);
    border-radius: 26px;
    background: var(--color-glow);
    max-width: 52em;
  }

  .redline-h {
    font-size: 24px;
    font-weight: 600;
  }

  .redline p:last-child {
    margin-top: 8px;
  }

  /* Not */
  .notp-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }

  .notp-head h2 {
    margin-top: 16px;
  }

  .notp-scene {
    margin-top: 32px;
    border-radius: var(--radius-card);
    overflow: hidden;
    rotate: -2deg;
    box-shadow: 0 16px 40px rgb(32 48 60 / 0.14);
  }

  .notp-list {
    display: grid;
    gap: 10px;
  }

  .notp-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 4px 20px;
    padding: 18px 22px;
    border-radius: 22px;
    background: var(--color-card);
    box-shadow: 0 1px 2px rgb(32 48 60 / 0.04), 0 3px 10px rgb(32 48 60 / 0.04);
    transition: translate 300ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .notp-row:hover {
      translate: 4px 0;
    }
  }

  .notp-not {
    font-family: var(--font-serif);
    font-size: 19px;
    font-weight: 580;
    text-decoration: line-through;
    text-decoration-color: var(--color-cta);
    text-decoration-thickness: 2.5px;
  }

  .notp-why {
    font-size: 15px;
    color: var(--color-ink-soft);
  }

  .notp-is {
    font-weight: 700;
    font-size: 15.5px;
  }

  .notp-is span {
    color: var(--color-sage);
  }

  /* Know */
  .know h2 {
    max-width: 16em;
  }

  .know-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    margin-top: clamp(32px, 4vw, 52px);
  }

  .know-col {
    padding: clamp(24px, 3.4vw, 40px);
    border-radius: var(--radius-card);
    background: var(--color-card);
    box-shadow: 0 1px 2px rgb(32 48 60 / 0.04), 0 10px 26px rgb(32 48 60 / 0.06);
  }

  .know-col ul {
    display: grid;
    gap: 10px;
    margin-top: 16px;
  }

  .know-col li {
    position: relative;
    padding-left: 26px;
    color: var(--color-ink-soft);
  }

  .know-col li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.45em;
    width: 12px;
    height: 12px;
    border-radius: 99px;
    background: var(--color-sage);
  }

  .know-stop li::before {
    background: var(--color-blush);
  }

  .know-note {
    margin-top: 24px;
    color: var(--color-ink-soft);
  }

  @media (min-width: 600px) {
    .notp-row {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }

    .notp-not {
      grid-row: span 2;
    }

    .mc-switch button {
      padding: 0 24px;
    }
  }

  @media (min-width: 900px) {
    .tale-grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    }

    .problems-grid,
    .mc-grid,
    .know-grid,
    .res-grid {
      grid-template-columns: 1fr 1fr;
    }

    .notp-grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }

    .notp-head {
      position: sticky;
      top: 110px;
    }

    .story-ride {
      left: -14%;
    }
  }

  @media (min-width: 1200px) {
    .res-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-mc]').forEach((root) => {
    const grid = root.querySelector<HTMLElement>('[data-mc-grid]')!;
    const radios = [...root.querySelectorAll<HTMLButtonElement>('[role="radio"]')];
    const pick = (r: HTMLButtonElement, focus = false) => {
      radios.forEach((x) => {
        x.setAttribute('aria-checked', String(x === r));
        x.tabIndex = x === r ? 0 : -1;
      });
      grid.dataset.who = r.dataset.who;
      if (focus) r.focus();
    };
    radios.forEach((r, i) => {
      r.tabIndex = i === 0 ? 0 : -1;
      r.addEventListener('click', () => pick(r));
      r.addEventListener('keydown', (e) => {
        if (['ArrowRight', 'ArrowDown', 'ArrowLeft', 'ArrowUp'].includes(e.key)) {
          e.preventDefault();
          pick(radios[(i + 1) % radios.length], true);
        }
      });
    });
  });
</script>
