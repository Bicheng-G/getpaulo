---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Phone from '../components/Phone.astro';
import CtaBand from '../components/CtaBand.astro';
import GetPaulo from '../components/GetPaulo.astro';
import FilmButton from '../components/FilmButton.astro';
import sceneHand from '../assets/clay/IntroHandOver.jpg';
import sceneSync from '../assets/clay/IntroSyncTogether.jpg';
import stone from '../assets/ui/stone.png';
import taxi from '../assets/ui/taxi.png';
import icon from '../assets/ui/app-icon.png';
import footprints from '../assets/clay/TrailFootprints.png';
import tabWish from '../assets/clay/tab-wish.png';
import tabJar from '../assets/clay/tab-wishjar.png';
import tabWeek from '../assets/clay/tab-myweek.png';
import tabTrail from '../assets/clay/tab-trail.png';
import tabFamily from '../assets/clay/tab-family.png';
import scrHome from '../assets/screens/home.png';
import scrJar from '../assets/screens/wishjar.png';
import scrFamily from '../assets/screens/family.png';

const loop = [
  { t: 'Snap a wish', b: 'Photograph the real thing your child wants. Paulo cuts it out as a sticker and suggests a name, on the device.' },
  { t: 'Agree what a star means', b: 'One star is a real family promise, like the price of one ride. You also agree how many choices a day.' },
  { t: 'Choose in the moment', b: 'When “I want it!” comes, hand over the phone. A breath, then two equal choices. The child taps.' },
  { t: 'See what happened', b: 'Saving puts a star on the next stone. Playing gets an equally warm “I chose this today.”' },
  { t: 'Ready, then real', b: 'Enough stars? Pick the day. When the wish is really in their hands, take the photo: it came true.' },
  { t: 'Look back, sometimes', b: 'My Trail keeps the things your family chose to keep: wishes that came true, photos, a voice.' },
];

const places = [
  {
    id: 'wish',
    name: 'Wish',
    icon: tabWish,
    title: 'The wish feels real',
    body: 'Home is your child’s own wish, big, with the stars still to go as stones on a path. The only instruction: “Tap yourself when it’s time to choose.” The child is the button.',
    why: 'The Choice Moment has to stay neutral, so this is where the wish gets to feel close.',
    screen: scrHome,
  },
  {
    id: 'jar',
    name: 'Wish Jar',
    icon: tabJar,
    title: 'Things that caught my eye',
    body: 'Every wish sticker, in two columns, with the clay camera for a new one. A wish they no longer want can be put away, and their stars stay theirs.',
    why: 'A place for planning and remembering, not a collecting game.',
    screen: scrJar,
  },
  {
    id: 'week',
    name: 'My Week',
    icon: tabWeek,
    title: 'Tickets they tear off',
    body: 'Weekly agreements, like two episodes of TV, become books of paper tickets. Tear one off to use it; a timer can end the turn. New tickets every Monday.',
    why: 'The grown-up sets how many; the child decides when. The book, not a tired parent, says “all done”.',
    video: '/media/clip-week.mp4',
    poster: '/media/clip-week-poster.jpg',
  },
  {
    id: 'trail',
    name: 'My Trail',
    icon: tabTrail,
    title: 'What our choices left behind',
    body: 'The same path, running back through time: wishes that came true, photos a grown-up adds, a voice note answering “What did you do today?”. It ends with footprints: this is where we are now.',
    why: 'Remembering what you did yourself makes it easier to do again. Only what the family wants to keep goes here; it is not a diary.',
    trail: true,
  },
  {
    id: 'family',
    name: 'Family',
    icon: tabFamily,
    title: 'The grown-ups’ door',
    body: 'Your family agreement, readable where you edit it. Settings, corrections and anything that spends stars sit behind a parent gate: a sum, or Face ID.',
    why: 'Rules a child can see, that never change quietly, are rules nobody has to argue about.',
    screen: scrFamily,
  },
];
---

<BaseLayout
  title="How it works"
  description="How Paulo works: snap a wish, agree what a star means, hand over the phone for a calm Choice Moment, then keep the promise together. The five places in the app, and the grown-up's part."
>
  <PageHero eyebrow="How it works" id="hiw-title">
    <Fragment slot="title">Small rituals for <span class="accent">big wants.</span></Fragment>
    <Fragment slot="lede">
      <p>
        Paulo is a few seconds of help in the moment it’s hardest, and then it gets out of the way.
        Here is everything it does, and why it does it that way.
      </p>
    </Fragment>
    <Fragment slot="actions">
      <GetPaulo />
      <FilmButton />
    </Fragment>
    <div slot="art" class="hiw-art">
      <Image src={sceneHand} alt="Clay scene: a grown-up kneels and hands a phone to a child beside a ride-on." widths={[420, 720]} sizes="(max-width: 900px) 90vw, 460px" loading="eager" />
    </div>
  </PageHero>

  <!-- The loop -->
  <section class="section-pad loop" aria-labelledby="loop-title">
    <div class="wrap">
      <p class="eyebrow">The loop</p>
      <h2 id="loop-title" class="headline loop-title">One wish, <span class="accent">start to finish.</span></h2>
      <ol class="loop-path">
        {
          loop.map((s, i) => (
            <li class="loop-step" style={`--i:${i}`}>
              <span class="loop-stone" aria-hidden="true">
                <Image src={stone} alt="" width={120} />
                <span>{i + 1}</span>
              </span>
              <div>
                <h3 class="title">{s.t}</h3>
                <p>{s.b}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- The Choice Moment in depth -->
  <section class="section-pad moment" aria-labelledby="moment-title">
    <div class="wrap moment-grid">
      <div class="moment-phone">
        <Phone label="A screen recording of a Choice Moment: breathing, two choices, then a ready wish." style="--w: clamp(250px, 24vw, 310px)">
          <video data-autoplay muted loop playsinline preload="none" poster="/media/clip-moment-poster.jpg" width="480" height="982">
            <source src="/media/clip-moment.mp4" type="video/mp4" />
          </video>
        </Phone>
        <button type="button" class="video-toggle" data-video-toggle aria-pressed="false">Pause</button>
      </div>
      <div class="moment-copy">
        <p class="eyebrow">The Choice Moment</p>
        <h2 id="moment-title" class="headline">Three beats, <span class="accent">twenty seconds.</span></h2>
        <ol class="beats">
          <li><b>Hand over.</b> The grown-up opens Paulo and passes the phone. The gesture says it without words: this is your decision.</li>
          <li><b>Breathe.</b> A little buddy breathes in and out with your child while their wish floats up. A pause, not a hurdle.</li>
          <li><b>Choose.</b> Two clay buttons, the same size: what they want now, and their wish. The path shows the stars still to go.</li>
        </ol>
        <h3 class="title moment-sub">Three details that keep the choice theirs</h3>
        <ul class="details">
          <li><span>Only a real tap counts.</span> Both buttons settle for a moment first; a held or sliding finger isn’t a choice.</li>
          <li><span>One change of mind.</span> Hold “Changed my mind” to go back. It leaves a visible line in the family’s record.</li>
          <li><span>No lock, no red.</span> When today’s choices are used, Paulo says so calmly: see you next time.</li>
        </ul>
        <a href="/#try" class="link moment-try">Try a Choice Moment on the home page →</a>
      </div>
    </div>
  </section>

  <!-- The five places -->
  <section class="section-pad places" aria-labelledby="places-title">
    <div class="wrap">
      <div class="places-head">
        <p class="eyebrow">Inside the app</p>
        <h2 id="places-title" class="headline">Four places for the child, <span class="accent">one door for you.</span></h2>
      </div>

      <div class="tabs" role="tablist" aria-label="Places in Paulo" data-tabs>
        {
          places.map((p, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${p.id}`}
              aria-controls={`panel-${p.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              class="tab"
            >
              <Image src={p.icon} alt="" width={44} />
              <span>{p.name}</span>
            </button>
          ))
        }
      </div>

      <div class="panels">
        {
          places.map((p, i) => (
            <div class="panel" role="tabpanel" id={`panel-${p.id}`} aria-labelledby={`tab-${p.id}`} hidden={i !== 0}>
              <div class="panel-phone">
                <Phone style="--w: clamp(240px, 22vw, 290px)" label={`The ${p.name} screen`}>
                  {p.screen && <Image src={p.screen} alt="" widths={[290, 580]} sizes="290px" />}
                  {p.video && (
                    <video data-autoplay muted loop playsinline preload="none" poster={p.poster} width="480" height="982">
                      <source src={p.video} type="video/mp4" />
                    </video>
                  )}
                  {p.trail && (
                    <div class="trail-mock">
                      <p class="trail-h serif">My Trail</p>
                      <p class="trail-sub">What our choices left behind</p>
                      <div class="trail-card">
                        <Image src={taxi} alt="" width={120} class="sticker-shadow" />
                        <div>
                          <p class="trail-card-t serif">Car</p>
                          <p class="trail-card-s">We got it! · Saturday</p>
                          <p class="trail-stars">★★★★★</p>
                        </div>
                      </div>
                      <div class="trail-stone" />
                      <div class="trail-voice">
                        <span class="trail-play">▶</span>
                        <span class="trail-wave" />
                        <span>0:12</span>
                      </div>
                      <p class="trail-q">What did you do today?</p>
                      <div class="trail-stone" />
                      <Image src={footprints} alt="" width={140} class="trail-feet" />
                    </div>
                  )}
                </Phone>
              </div>
              <div class="panel-copy">
                <h3 class="headline panel-title">{p.title}</h3>
                <p class="lede">{p.body}</p>
                <p class="panel-why"><b>Why:</b> {p.why}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- The grown-up's part -->
  <section class="section-pad role" aria-labelledby="role-title">
    <div class="wrap">
      <p class="eyebrow">Your part</p>
      <h2 id="role-title" class="headline">You set the deal. <span class="accent">They make the choice.</span></h2>
      <div class="role-grid">
        <article class="card role-card">
          <span class="role-n" aria-hidden="true">1</span>
          <h3 class="title">Set the deal</h3>
          <p>What one star means, how many choices a day, the weekly tickets. Written down where everyone can see it, and never changed quietly.</p>
        </article>
        <article class="card role-card">
          <span class="role-n" aria-hidden="true">2</span>
          <h3 class="title">Hand over, then stop</h3>
          <p>Explain once, offer help if they want it, then let them choose. Before you hand over, Paulo may give you one private line to remember: a reminder, never a push.</p>
        </article>
        <article class="card role-card">
          <span class="role-n" aria-hidden="true">3</span>
          <h3 class="title">Follow through</h3>
          <p>When a wish is ready, pick the day and keep it. A promise kept in real life is the whole point.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Fast, and for the whole family -->
  <section class="section-pad out" aria-labelledby="out-title">
    <div class="wrap out-grid">
      <div class="out-art" aria-hidden="true">
        <div class="qa">
          <div class="qa-icon"><Image src={icon} alt="" width={120} /></div>
          <ul class="qa-menu">
            <li><span>Choice Moment</span><svg viewBox="0 0 24 24"><path d="M12 3l2.6 5.6 6.1.8-4.5 4.2 1.2 6-5.4-3-5.4 3 1.2-6L3.3 9.4l6.1-.8z"></path></svg></li>
            <li><span>New wish</span><svg viewBox="0 0 24 24"><path d="M4 8h3l2-2.5h6L17 8h3v11H4zM12 11a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"></path></svg></li>
          </ul>
        </div>
      </div>
      <div class="out-copy">
        <p class="eyebrow">Made for being out</p>
        <h2 id="out-title" class="headline">Fast enough for <span class="accent">the checkout queue.</span></h2>
        <p class="lede">Long-press the Paulo icon, or ask Siri, to go straight to a Choice Moment or a new wish. The whole ritual takes about twenty seconds.</p>
        <ul class="facts">
          <li><b>Several children.</b> Each has their own wishes, stars and path. Never side by side, never compared.</li>
          <li><b>Two grown-ups.</b> With Paulo Family, a promise one of you makes shows on the other’s phone.</li>
          <li><b>Five languages.</b> English, 简体中文, 繁體中文, 日本語 and Español.</li>
        </ul>
      </div>
      <div class="out-scene">
        <Image src={sceneSync} alt="Clay scene: a child and a grown-up with glasses look at Paulo together." widths={[360, 640]} sizes="(max-width: 900px) 90vw, 360px" />
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .hiw-art {
    width: min(100%, 460px);
    border-radius: var(--radius-keepsake);
    overflow: hidden;
    rotate: -2deg;
    box-shadow: 0 20px 50px rgb(32 48 60 / 0.16);
  }

  .hiw-art :global(img),
  .out-scene :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* The loop as a stone path */
  .loop-title {
    margin-top: 16px;
  }

  .loop-path {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px 64px;
    margin-top: clamp(40px, 5vw, 64px);
  }

  .loop-step {
    display: grid;
    grid-template-columns: 76px 1fr;
    gap: 20px;
    align-items: start;
  }


  .loop-stone {
    position: relative;
    display: grid;
    place-items: center;
    width: 76px;
    rotate: calc((var(--i) - 2.5) * 5deg);
    transition: rotate 500ms var(--spring-bouncy), scale 500ms var(--spring-bouncy);
  }

  @media (hover: hover) and (pointer: fine) {
    .loop-step:hover .loop-stone {
      rotate: 0deg;
      scale: 1.08;
    }
  }

  .loop-stone :global(img) {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 4px 4px rgb(32 48 60 / 0.12));
  }

  .loop-stone span {
    position: absolute;
    inset: 0 0 8% 0;
    display: grid;
    place-items: center;
    font-family: var(--font-serif);
    font-size: 26px;
    font-weight: 650;
    color: var(--color-ink);
    background: radial-gradient(closest-side, rgb(236 232 224), rgb(236 232 224) 55%, transparent 56%);
  }

  .loop-step p {
    margin-top: 6px;
    color: var(--color-ink-soft);
    max-width: 30em;
  }

  /* Moment */
  .moment-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(40px, 7vw, 112px);
    align-items: center;
  }

  .moment-phone {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    justify-self: center;
  }

  .moment-copy {
    order: -1;
  }

  .video-toggle {
    min-height: 40px;
    padding: 0 16px;
    border: 0;
    border-radius: 999px;
    background: var(--color-card);
    font-size: 14px;
    font-weight: 800;
    color: var(--color-ink-soft);
    box-shadow: 0 1px 2px rgb(32 48 60 / 0.06), 0 3px 8px rgb(32 48 60 / 0.05);
  }

  .moment-copy h2 {
    margin-top: 16px;
  }

  .beats {
    display: grid;
    gap: 14px;
    margin-top: 28px;
    counter-reset: beat;
  }

  .beats li {
    position: relative;
    padding-left: 44px;
    color: var(--color-ink-soft);
    counter-increment: beat;
    max-width: 36em;
  }

  .beats li::before {
    content: counter(beat);
    position: absolute;
    left: 0;
    top: -2px;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 99px;
    background: var(--color-cta);
    color: var(--color-cta-label);
    font-size: 14px;
    font-weight: 800;
  }

  .beats b,
  .details span,
  .facts b {
    color: var(--color-ink);
  }

  .moment-sub {
    margin-top: 40px;
    font-size: 22px;
  }

  .details {
    display: grid;
    gap: 10px;
    margin-top: 16px;
  }

  .details li {
    padding: 14px 18px;
    border-radius: 18px;
    background: var(--color-card);
    color: var(--color-ink-soft);
    box-shadow: 0 1px 2px rgb(32 48 60 / 0.04), 0 3px 10px rgb(32 48 60 / 0.04);
  }

  .details span {
    font-weight: 800;
  }

  .moment-try {
    display: inline-block;
    margin-top: 24px;
    font-weight: 800;
  }

  /* Places */
  .places-head h2 {
    margin-top: 16px;
    max-width: 16em;
  }

  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    width: fit-content;
    max-width: 100%;
    margin-top: 36px;
    padding: 8px;
    border-radius: 26px;
    background: var(--color-card);
    box-shadow: 0 1px 2px rgb(32 48 60 / 0.05), 0 6px 18px rgb(32 48 60 / 0.06);
  }

  .tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 52px;
    padding: 4px 6px;
    border: 0;
    border-radius: 18px;
    background: transparent;
    font-weight: 800;
    color: var(--color-ink-soft);
    transition: background-color 220ms ease, color 220ms ease;
  }

  .tab :global(img) {
    width: 40px;
    height: 40px;
    transition: transform 500ms var(--spring-bouncy);
  }

  /* Phones: icon-only tabs; the selected one also shows its name. */
  .tab span {
    display: none;
  }

  .tab[aria-selected='true'] span {
    display: inline;
    padding-right: 10px;
  }

  .tab:hover {
    color: var(--color-ink);
  }

  .tab[aria-selected='true'] {
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .tab[aria-selected='true'] :global(img) {
    transform: translateY(-3px) rotate(-6deg) scale(1.08);
  }

  .tab:active {
    scale: 0.97;
  }

  .panels {
    margin-top: 40px;
  }

  .panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }

  .panel-phone {
    justify-self: center;
  }

  .panel:not([hidden]) .panel-phone {
    animation: panel-in 700ms var(--spring-soft) both;
  }

  .panel:not([hidden]) .panel-copy {
    animation: panel-in 700ms var(--spring-soft) 60ms both;
  }

  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(14px);
      filter: blur(4px);
    }
  }

  .panel-title {
    font-size: clamp(2rem, 3.6vw, 3rem);
  }

  .panel-copy .lede {
    margin-top: 18px;
    max-width: 28em;
  }

  .panel-why {
    margin-top: 18px;
    max-width: 32em;
    padding: 16px 20px;
    border-radius: 18px;
    background: var(--color-card-warm);
    color: var(--color-ink-soft);
    box-shadow: inset 0 0 0 1px rgb(32 48 60 / 0.06);
  }

  .panel-why b {
    color: var(--color-cta);
  }

  /* My Trail, drawn in HTML (there is no recording of it yet) */
  .trail-mock {
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100%;
    padding: 9% 8% 6%;
    font-size: calc(var(--w) * 0.045);
  }

  .trail-h {
    align-self: flex-start;
    font-size: 1.7em;
    font-weight: 600;
    line-height: 1.1;
  }

  .trail-sub {
    align-self: flex-start;
    font-size: 0.75em;
    color: var(--color-ink-soft);
  }

  .trail-card {
    display: flex;
    align-items: center;
    gap: 0.6em;
    width: 100%;
    margin-top: 1.4em;
    padding: 0.7em;
    border-radius: 1em;
    background: var(--color-wins-deep);
    color: var(--color-cta-label);
    rotate: -2deg;
  }

  .trail-card :global(img) {
    width: 3.4em;
    height: auto;
  }

  .trail-card-t {
    font-size: 1.3em;
    font-weight: 600;
  }

  .trail-card-s {
    font-size: 0.75em;
    opacity: 0.7;
  }

  .trail-stars {
    color: var(--color-star);
    font-size: 0.8em;
    letter-spacing: 0.1em;
  }

  .trail-stone {
    width: 2.2em;
    height: 1.4em;
    margin: 0.8em 0;
    border-radius: 50%;
    background: #e3ddd2;
    box-shadow: 0 2px 2px rgb(32 48 60 / 0.12);
  }

  .trail-voice {
    display: flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.5em 0.9em;
    border-radius: 999px;
    background: var(--color-card);
    font-size: 0.8em;
    font-weight: 700;
    box-shadow: 0 2px 6px rgb(32 48 60 / 0.08);
  }

  .trail-play {
    color: var(--color-cta);
  }

  .trail-wave {
    width: 5em;
    height: 1.1em;
    background: repeating-linear-gradient(90deg, var(--color-lilac) 0 2px, transparent 2px 5px);
    mask: linear-gradient(transparent, #000 30% 70%, transparent);
  }

  .trail-q {
    margin-top: 0.4em;
    font-size: 0.72em;
    color: var(--color-ink-soft);
  }

  .trail-mock :global(.trail-feet) {
    width: 4em;
    height: auto;
    margin-top: auto;
  }

  /* Role */
  .role h2 {
    margin-top: 16px;
    max-width: 16em;
  }

  .role-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    margin-top: clamp(32px, 4vw, 52px);
  }

  .role-card {
    padding: clamp(24px, 3vw, 34px);
    transition: translate 300ms var(--ease-out), box-shadow 300ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .role-card:hover {
      translate: 0 -3px;
    }
  }

  .role-n {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 14px;
    background: var(--color-glow);
    font-weight: 900;
    color: var(--color-star-deep);
    rotate: -6deg;
  }

  .role-card h3 {
    margin-top: 18px;
  }

  .role-card p {
    margin-top: 8px;
    color: var(--color-ink-soft);
  }

  /* Out and about */
  .out-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(32px, 4vw, 64px);
    align-items: center;
  }

  .out-copy h2 {
    margin-top: 16px;
    font-size: clamp(2rem, 3.6vw, 3.2rem);
  }

  .out-copy .lede {
    margin-top: 18px;
  }

  .facts {
    display: grid;
    gap: 10px;
    margin-top: 24px;
    color: var(--color-ink-soft);
  }

  .qa {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding: 28px;
    border-radius: 32px;
    background: linear-gradient(160deg, #cfd9e4, #e9dccb);
  }

  .qa-icon {
    width: 88px;
    border-radius: 24%;
    overflow: hidden;
    box-shadow: 0 8px 18px rgb(32 48 60 / 0.2);
    animation: qa-press 3.6s var(--ease-out) infinite;
  }

  .qa-icon :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  @keyframes qa-press {
    0%,
    100% {
      transform: none;
    }
    12% {
      transform: scale(0.94);
    }
    24% {
      transform: scale(1.04);
    }
    32% {
      transform: none;
    }
  }

  .qa-menu {
    width: 100%;
    min-width: 200px;
    border-radius: 18px;
    background: rgb(255 255 255 / 0.82);
    backdrop-filter: blur(10px);
    box-shadow: 0 10px 30px rgb(32 48 60 / 0.14);
    overflow: hidden;
    transform-origin: top left;
    animation: qa-menu 3.6s var(--ease-out) infinite;
  }

  /* The menu re-pops each time the icon is pressed; it is never invisible. */
  @keyframes qa-menu {
    0%,
    10% {
      transform: none;
    }
    16% {
      transform: scale(0.95);
    }
    30%,
    100% {
      transform: none;
    }
  }

  .qa-menu li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 13px 16px;
    font-weight: 700;
  }

  .qa-menu li + li {
    border-top: 1px solid rgb(32 48 60 / 0.08);
  }

  .qa-menu svg {
    width: 20px;
    fill: none;
    stroke: var(--color-ink);
    stroke-width: 1.8;
    stroke-linejoin: round;
  }

  .out-scene {
    display: none;
    border-radius: var(--radius-keepsake);
    overflow: hidden;
    rotate: 3deg;
    box-shadow: 0 16px 40px rgb(32 48 60 / 0.14);
  }

  @media (min-width: 900px) {
    .loop-path {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .loop-step:nth-child(even) {
      translate: 0 48px;
    }

    .moment-grid,
    .panel {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .moment-copy {
      order: 0;
    }

    .panel-phone,
    .moment-phone {
      justify-self: auto;
    }

    .role-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .out-grid {
      grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    }

    .tab {
      padding: 4px 16px 4px 6px;
    }

    .tab span,
    .tab[aria-selected='true'] span {
      display: inline;
      padding-right: 0;
    }
  }

  @media (min-width: 1200px) {
    .out-grid {
      grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.35fr) minmax(0, 0.7fr);
    }

    .out-scene {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .qa-icon,
    .qa-menu {
      animation: none;
    }
  }
</style>

<script>
  import { reduced } from '../scripts/motion';

  // Tabs: click, or arrow keys between them (WAI-ARIA tabs pattern).
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((list) => {
    const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement, focus = false) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls')!)!;
        panel.hidden = !on;
        panel.querySelectorAll<HTMLVideoElement>('video').forEach((v) => (on && !reduced() ? v.play().catch(() => {}) : v.pause()));
      });
      if (focus) tab.focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t));
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (e.key === 'Home') select(tabs[0], true);
        if (e.key === 'End') select(tabs[tabs.length - 1], true);
        if (d) select(tabs[(i + d + tabs.length) % tabs.length], true);
      });
    });
  });

  // Muted screen recordings play only while visible, and never under Reduce Motion.
  const videos = [...document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]')];
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        const v = e.target as HTMLVideoElement;
        if (e.isIntersecting && !reduced() && !v.dataset.userPaused) {
          v.preload = 'auto';
          v.play().catch(() => {});
        } else {
          v.pause();
        }
      });
    }, { threshold: 0.35 });
    videos.forEach((v) => io.observe(v));
  }

  document.querySelectorAll<HTMLButtonElement>('[data-video-toggle]').forEach((btn) => {
    const v = btn.parentElement!.querySelector('video')!;
    const sync = () => {
      btn.textContent = v.paused ? 'Play' : 'Pause';
      btn.setAttribute('aria-pressed', String(v.paused));
    };
    v.addEventListener('play', sync);
    v.addEventListener('pause', sync);
    sync();
    btn.addEventListener('click', () => {
      if (v.paused) {
        delete v.dataset.userPaused;
        v.play().catch(() => {});
      } else {
        v.dataset.userPaused = '1';
        v.pause();
      }
    });
  });
</script>
