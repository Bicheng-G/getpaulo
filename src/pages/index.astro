---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import WantIt from '../components/home/WantIt.astro';
import ChoiceDemo from '../components/home/ChoiceDemo.astro';
import StoryCards from '../components/home/StoryCards.astro';
import Tickets from '../components/home/Tickets.astro';
import Together from '../components/home/Together.astro';
import Trust from '../components/home/Trust.astro';
import NotList from '../components/home/NotList.astro';
import Close from '../components/home/Close.astro';
---

<BaseLayout
  title="Paulo"
  description="Paulo is an iPhone app for families with children aged 4 to 8. A child photographs a real wish, chooses between enjoying something now or saving toward it, and watches a family promise become real. Free for children, forever. No ads, no tracking, no account."
>
  <Hero />
  <WantIt />
  <ChoiceDemo />
  <StoryCards />
  <Tickets />
  <Together />
  <Trust />
  <NotList />
  <Close />
</BaseLayout>
