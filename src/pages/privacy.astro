---
import { getEntry, render } from 'astro:content';
import ProseLayout from '../layouts/ProseLayout.astro';

const entry = await getEntry('legal', 'privacy-policy');
if (!entry) throw new Error('src/content/legal/privacy-policy.md is missing.');
const { Content } = await render(entry);

const lastUpdated = entry.data.lastUpdated.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<ProseLayout
  title={entry.data.title}
  description={entry.data.description}
  meta={`Last updated ${lastUpdated}`}
>
  <Content />
</ProseLayout>
