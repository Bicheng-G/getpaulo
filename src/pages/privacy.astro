---
import { getEntry, render } from 'astro:content';
import ProseLayout from '../layouts/ProseLayout.astro';

// Rendered from docs/release/privacy-policy.md — the same document referenced by
// the App Store submission. See src/content.config.ts.
const entry = await getEntry('legal', 'privacy-policy');
if (!entry) throw new Error('docs/release/privacy-policy.md is missing.');
const { Content } = await render(entry);
---

<ProseLayout
  title="Privacy Policy"
  description="Paulo stores everything on your own device. No accounts, no server, no analytics, no tracking, and no network requests of any kind."
>
  <Content />
</ProseLayout>
